# Binaries are distributed via GitHub Releases, not git (several exceed
# GitHub's 100 MB per-file push limit). Keep only docs and license texts.
*.exe
*.dll
*.addon64
*.pyd
*.zip
*.7z
*.pth
__pycache__/

# Keep these committable companions next to the (ignored) binaries.
!BINARIES.md
!LICENSE
!LICENSE-*.txt
!README.txt
!.gitkeep
!.gitignore

# Locally built Linux worker and separately obtained runtime/license copies.
/runtime/dlssg/dlssg-worker
/runtime/dlssg/libnvidia-ngx-dlssg.so.*
/runtime/dlssg/LICENSE-WanGP-Adapters.txt
/runtime/dlssg/LICENSE-NVIDIA-DLSS-Linux.txt
/runtime/dlssg/.build-*/
